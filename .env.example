# Postgres
DATABASE_URL=postgres://localhost:5432/asof

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=NOVA

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=your-org
GITHUB_REPOS=repo-one,repo-two

# Anthropic (brief narration — production path)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (free local fallback for brief narration, dev/demo only — used when ANTHROPIC_API_KEY
# is unset. Requires `brew install ollama && ollama pull llama3.1:8b` or similar.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
